# Copy to .env.local and fill with your real Supabase project values.
# Leave these as placeholders (or unset) to run DataHUB in MOCK mode — a fully
# functional in-memory demo backend with no Supabase required.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_key
